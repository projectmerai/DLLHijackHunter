<!-- src/DLLHijackHunter/DLLHijackHunter.csproj -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>DLLHijackHunter</AssemblyName>
    <RootNamespace>DLLHijackHunter</RootNamespace>
    <Version>2.5.0</Version>
    <Authors>Project Merai</Authors>
    <Company>Project Merai</Company>
    <Product>DLLHijackHunter</Product>
    <PackageProjectUrl>https://projectmerai.com/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ghostvectoracademy/DLLHijackHunter</RepositoryUrl>
    <Copyright>Copyright © 2024-2026 Project Merai. All rights reserved.</Copyright>
    <Description>Automated DLL Hijacking Detection Tool for finding and verifying exploits</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.8" />
    <PackageReference Include="PeNet" Version="4.0.1" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="TaskScheduler" Version="2.12.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\phantom_dlls.json" />
    <EmbeddedResource Include="Resources\hijacklibs.json" />
    <!-- Precompiled self-locating canaries (no compiler needed at scan time) and the
         auditable source they are built from. Rebuild via Resources\build_canary.bat. -->
    <EmbeddedResource Include="Resources\canary_x64.dll" />
    <EmbeddedResource Include="Resources\canary_x86.dll" />
    <EmbeddedResource Include="Resources\canary_src.c" />
  </ItemGroup>

</Project>